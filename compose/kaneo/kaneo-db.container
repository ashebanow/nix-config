[Unit]
Description=Kaneo PostgreSQL
After=kaneo.network.service
Requires=kaneo.network.service

[Container]
Image=docker.io/library/postgres:16-alpine
# podman 5.8 would otherwise name this systemd-kaneo-db; set the DNS name
# explicitly so the app's POSTGRES_HOST=kaneo-db resolves.
ContainerName=kaneo-db
Network=kaneo.network
# No PublishPort — database is tailnet-internal only.
# DB/USER/PASSWORD all come from BWS via podman secrets (populate-secrets.sh).
Secret=kaneo-postgres-db,type=env,target=POSTGRES_DB
Secret=kaneo-postgres-user,type=env,target=POSTGRES_USER
Secret=kaneo-postgres-password,type=env,target=POSTGRES_PASSWORD
Volume=kaneo-pgdata.volume:/var/lib/postgresql/data
HealthCmd=/usr/local/bin/pg_isready -U kaneo -d kaneo
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5

[Service]
Restart=always
