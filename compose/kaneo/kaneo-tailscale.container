[Unit]
Description=Kaneo Tailscale sidecar (userspace; funnel 443 -> localhost:5173)
After=kaneo.network.service
Requires=kaneo.network.service

[Container]
Image=docker.io/tailscale/tailscale:latest
# Explicit name so it's addressable as `kaneo-ts` and podman DNS stays stable.
ContainerName=kaneo-ts
Network=kaneo.network
# Rootless: keep the default TS_USERSPACE (userspace networking). Do NOT add
# AddDevice=/dev/net/tun or AddCapability= — those exist only for kernel
# networking (TS_USERSPACE=false), which would break rootless without
# privileged device access. Cost is lower throughput — irrelevant here.
Secret=kaneo-tailscale-auth-key,type=env,target=TS_AUTHKEY
# Stable tailnet node name — the funnel URL is https://kaneo.fluffy-walleye.ts.net.
Environment=TS_HOSTNAME=kaneo
Environment=TS_STATE_DIR=/var/lib/tailscale
# Reuse the existing node identity across restarts (state persists in the
# ts-state volume). WITHOUT this, every restart re-auths with the reusable
# auth key, registering a NEW node each time — we always pass hostname kaneo,
# but tailscale auto-suffixes (kaneo, kaneo-1, kaneo-2, …) to dedupe. That
# churn also breaks the funnel HTTPS cert (tailscale/tailscale#15702). Do NOT
# use an ephemeral auth key here: ephemeral + funnel is the broken combination.
# The auth key should stay reusable so a state-loss re-auth creates a
# persistent (funnel-capable) node.
Environment=TS_AUTH_ONCE=true
Environment=TS_SERVE_CONFIG=/etc/tailscale/serve/serve-config.json
# Bind the containing DIRECTORY, not the file — required for config-update
# detection when the store symlink is swapped on rebuild.
Volume=kaneo-ts-state.volume:/var/lib/tailscale
Volume=/etc/kaneo/tailscale-serve:/etc/tailscale/serve:ro
# Accept MagicDNS so ${TS_CERT_DOMAIN} resolves for serve config.
Environment=TS_ACCEPT_DNS=true

[Service]
Restart=on-failure
TimeoutStartSec=300
