{
  "client": {
    "enable_logging": true,
    "log_retention_days": 30,
    "enforce_auth_on_inference": false
  },
  "source_of_truth": "config.json",
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/config.db"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/logs.db"
    }
  },
  "providers": {
    "qwen": {
      "keys": [
        {
          "name": "qwen-local",
          "value": "sk-dummy",
          "models": ["qwen-latest", "qwen-35b-a3b"],
          "weight": 1.0,
          "aliases": {
            "qwen-latest": "qwen-35b-a3b"
          }
        }
      ],
      "network_config": {
        "base_url": "http://qwen-35b-a3b:8080",
        "allow_private_network": true,
        "default_request_timeout_in_seconds": 2700
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": true
        }
      }
    },
    "anthropic": {
      "keys": [
        {
          "name": "anthropic",
          "value": "env.ANTHROPIC_API_KEY",
          "models": [
            "claude-haiku-4-5-20251001",
            "claude-sonnet-5",
            "claude-opus-5",
            "claude-fable-5-1"
          ],
          "weight": 1.0
        }
      ]
    },
    "deepseek": {
      "keys": [
        {
          "name": "deepseek",
          "value": "env.DEEPSEEK_API_KEY",
          "models": ["deepseek-v4-pro", "deepseek-v4-flash"],
          "weight": 1.0
        }
      ]
    },
    "gemini": {
      "keys": [
        {
          "name": "gemini",
          "value": "env.GEMINI_API_KEY",
          "models": ["gemini-3.7-flash", "gemini-3.6-flash", "gemini-3.5-flash", "gemini-3.5-flash-lite"],
          "weight": 1.0
        }
      ]
    }
  }
}
